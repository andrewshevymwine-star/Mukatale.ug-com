{
  "kind": "collectionType",
  "collectionName": "markets",
  "info": {
    "singularName": "market",
    "pluralName": "markets",
    "displayName": "market"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "featured": {
      "type": "boolean"
    },
    "m_code": {
      "type": "string",
      "unique": true
    },
    "location": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "vendors": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::vendor.vendor",
      "mappedBy": "market"
    },
    "products": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::product.product",
      "mappedBy": "markets"
    }
  }
}
